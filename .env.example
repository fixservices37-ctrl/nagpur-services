# Copy to .env and fill in the values for your own Supabase project.
# VITE_* variables are injected into the browser bundle — never put a secret
# (service role key, SMTP password) behind a VITE_ prefix.

SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Canonical site origin, used for canonical tags and og:url.
# Set this to the live domain in the production environment.
VITE_SITE_URL="https://nagpur-home-care.lovable.app"

# --- Prisma (server-side tooling only — never exposed to the browser) --------
# PUT THESE IN .env.local, NOT HERE: they contain the database password, they
# bypass Row Level Security, and .env is committed while .env.local is ignored.
#
# Supabase → Project Settings → Database → Connection string.
#   DATABASE_URL = pooled connection (Transaction pooler, port 6543)
#   DIRECT_URL   = direct connection (port 5432), used by `prisma db pull`
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
