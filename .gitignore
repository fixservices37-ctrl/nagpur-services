# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
dist-ssr/
.output/
.nitro/
.vinxi/
.tanstack/**
.wrangler/
.dev.vars
build/
out/

# ---------------------------------------------------------------------------
# Generated / cache
# ---------------------------------------------------------------------------
# Prisma client — regenerate with `npm run db:generate`.
src/generated/
# TanStack Router's autogenerated tree is committed on purpose (keeps type
# inference working for CI type-checks). Do not add routeTree.gen.ts here.
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
.cache/
.temp/
.tmp/

# ---------------------------------------------------------------------------
# Environment files
# ---------------------------------------------------------------------------
# We intentionally COMMIT .env — it only holds the public Supabase publishable
# key which is meant to ship to the browser, and Lovable syncs it back on push.
# Never put the database password, service-role key, or any secret in .env;
# put those in .env.local (or .env.<mode>.local), which git ignores.
*.local
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*

# ---------------------------------------------------------------------------
# Testing / coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ---------------------------------------------------------------------------
# Editors & AI tools
# ---------------------------------------------------------------------------
# VS Code: keep only the recommended-extensions list under version control.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

.idea/
.zed/
.cursor/
.claude/
.aider*
*.swp
*.swo
*.sw?

# Visual Studio detritus that occasionally appears alongside JS projects.
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# ---------------------------------------------------------------------------
# OS-generated files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Miscellaneous
# ---------------------------------------------------------------------------
*.bak
*.old
*.orig
*.rej
*.pem
*.key
*.p12
secrets/

# Lockfile: this project uses bun.lock. package-lock.json only appears when a
# contributor runs `npm install` for a Node-side script; do not commit it.
package-lock.json
